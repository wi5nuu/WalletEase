# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/payflow
DB_USERNAME=payflow
DB_PASSWORD=secret

# JWT Configuration
# Must be at least 256 bits (32 characters) for HS256
JWT_SECRET=your-256-bit-secret-here-must-be-at-least-32-characters-long
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# Integration Service
INTERNAL_API_KEY=internal-secret-key-for-service-communication
INTEGRATION_SERVICE_URL=http://localhost:8081

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Server
SERVER_PORT=8080
